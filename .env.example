# SRP Prime Wealth Financial Freedom Planner - Environment Variables
# Copy this file to .env for local testing with Supabase, or set these in Vercel Settings -> Environment Variables.

# Supabase Project URL (from Supabase Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (RECOMMENDED for serverless backend - bypasses RLS safely)
# Found in: Supabase Dashboard -> Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Alternatively, you can use the Anon Public Key if RLS policies are set to allow all:
# SUPABASE_ANON_KEY=your-supabase-anon-public-key

# JWT Secret for client session tokens (optional - defaults to internal secure secret)
JWT_SECRET=srp_prime_wealth_jwt_secret_key_2026_secure
